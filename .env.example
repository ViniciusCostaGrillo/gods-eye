# ============================================================================
# 𓂀 God's Eye — Zero-Config Default Environment (.env)
# ============================================================================
# God's Eye works out-of-the-box without requiring any paid API keys!
# All 21+ public OSINT adapters (RDAP, Google DoH, crt.sh, Shodan InternetDB,
# ip-api, RIPEstat, Wayback, GitHub, Gravatar, Keybase, HIBP Metadata, urlscan,
# BrasilAPI CNPJ/QSA, ViaCEP/BrasilAPI CEP, Querido Diário, Portal da
# Transparência, DataJud/CNJ, Phone OSINT E.164/DDD/ANATEL, Crypto OSINT
# BTC/ETH/TRON/SOL + OFAC, Hudson Rock Cavalier, Image EXIF) run immediately.
# ============================================================================

GODSEYE_OFFLINE_DEMO_FALLBACK=true
GODSEYE_CACHE_TTL_SECONDS=3600
GODSEYE_L1_CACHE_MAX_SIZE=512
GODSEYE_HTTP_TIMEOUT_SECONDS=12.0
GODSEYE_HTTP_MAX_RETRIES=3
GODSEYE_MAX_CONCURRENCY=8
GODSEYE_RETENTION_DAYS=90

# Optional API Keys (leave blank to use free public endpoints & fallback)
# GODSEYE_HIBP_API_KEY=
# GODSEYE_SHODAN_API_KEY=
# GODSEYE_VIRUSTOTAL_API_KEY=
# GODSEYE_URLSCAN_API_KEY=
# GODSEYE_ABUSEIPDB_API_KEY=
# GODSEYE_GITHUB_TOKEN=
# GODSEYE_PORTAL_TRANSPARENCIA_API_KEY=
# GODSEYE_DATAJUD_API_KEY=
